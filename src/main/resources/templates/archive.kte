@import jp.yappo.pologen.infrastructure.rendering.ArchivePageModel
@param model:ArchivePageModel
<!DOCTYPE html>
<html lang="${model.site.language}">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width,initial-scale=1"/>
    <title>Archive - ${model.site.title}</title>
    <meta name="description" content="Article archive for ${model.site.title}"/>
    <link rel="icon" href="${model.site.faviconUrl}"/>
@for (href in model.site.stylesheets)    <link rel="stylesheet" href="${href}"/> @endfor
@for (src in model.site.scripts)    <script src="${src}"></script> @endfor
</head>
<body class="bg-slate-950 text-slate-100 font-sans">
<div class="min-h-screen flex flex-col">
    <header class="border-b border-slate-800 bg-slate-900/50">
        <div class="mx-auto w-full max-w-4xl px-4 py-6 flex items-center justify-between gap-4">
            <a href="${model.site.blogTopUrl}" class="text-xl font-semibold tracking-tight hover:text-slate-200 transition">${model.site.title}</a>
            <nav class="flex items-center gap-4 text-sm">
                @if (model.site.tagsUrl != null)
                    <a href="${model.site.tagsUrl}" class="text-slate-300 hover:text-white transition">Tags</a>
                @endif
                <span class="text-slate-400">Archive</span>
            </nav>
        </div>
    </header>
    <main class="flex-1">
        <div class="mx-auto w-full max-w-4xl px-4 py-10 space-y-10">
            <h1 class="text-3xl md:text-4xl font-bold text-white">Archive</h1>
            @for (month in model.months)
                <section class="space-y-4">
                    <h2 class="text-2xl font-semibold text-white border-b border-slate-800 pb-2">${month.label}</h2>
                    <ul class="space-y-4">
                    @for (entry in month.entries)
                        <li class="rounded-xl border border-slate-800 bg-slate-900/60 p-4">
                            <a href="${entry.href}" class="text-lg font-semibold text-sky-300 hover:text-sky-200 transition">${entry.title}</a>
                            <p class="text-xs text-slate-500 mt-1">${entry.publishDateLocal}</p>
                            <p class="text-sm text-slate-300 mt-2">${entry.summary}</p>
                        </li>
                    @endfor
                    </ul>
                </section>
            @endfor
        </div>
    </main>
</div>
</body>
</html>
