@import jp.yappo.pologen.infrastructure.rendering.TagIndexPageModel
@param model:TagIndexPageModel
<!DOCTYPE html>
<html lang="${model.site.language}">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width,initial-scale=1"/>
    <title>Tags - ${model.site.title}</title>
    <meta name="description" content="Article tags for ${model.site.title}"/>
    <link rel="icon" href="${model.site.faviconUrl}"/>
@for (href in model.site.stylesheets)    <link rel="stylesheet" href="${href}"/> @endfor
@for (src in model.site.scripts)    <script src="${src}"></script> @endfor
</head>
<body class="bg-slate-950 text-slate-100 font-sans">
<div class="min-h-screen flex flex-col">
    <header class="border-b border-slate-800 bg-slate-900/50">
        <div class="mx-auto w-full max-w-4xl px-4 py-6 flex items-center justify-between gap-4">
            <a href="${model.site.blogTopUrl}" class="text-xl font-semibold tracking-tight hover:text-slate-200 transition">${model.site.title}</a>
            <span class="text-sm text-slate-400">Tags</span>
        </div>
    </header>
    <main class="flex-1">
        <div class="mx-auto w-full max-w-4xl px-4 py-10 space-y-8">
            <h1 class="text-3xl md:text-4xl font-bold text-white">Tags</h1>
            <ul class="flex flex-wrap gap-3">
            @for (tag in model.tags)
                <li>
                    <a href="${tag.url}" class="inline-flex items-center gap-2 rounded-full border border-slate-700 bg-slate-900 px-4 py-2 text-sky-300 hover:border-slate-500 hover:text-sky-200 transition">
                        <span>#${tag.name}</span>
                        <span class="text-xs text-slate-500">${tag.entryCount}</span>
                    </a>
                </li>
            @endfor
            </ul>
        </div>
    </main>
</div>
</body>
</html>
